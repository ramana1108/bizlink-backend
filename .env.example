# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/bizlinkDB
JWT_SECRET=bizlink_jwt_secure_secret_key

# Profectus BizLink Business Email / SMTP Configuration
